<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        {%- set version = "1.6.19" %}
        {%- set mainColor = "#000000" %}
        {% block head %}{% endblock %}
        <link rel="stylesheet" href="/css/style.css?v={{version}}">
        <!-- Favicons -->
        <link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon/favicon-16x16.png">
        <link rel="manifest" href="/img/favicon/site.webmanifest">
        <link rel="mask-icon" href="/img/favicon/safari-pinned-tab.svg" color="{{mainColor}}">
        <link rel="shortcut icon" href="/img/favicon/favicon.ico">
        <meta name="msapplication-TileColor" content="{{mainColor}}">
        <meta name="msapplication-config" content="/img/favicon/browserconfig.xml">
        <meta name="theme-color" content="{{mainColor}}">
    </head>

    <body>
        {% block content %}{% endblock %}

        <script src="/js/base.js?v={{version}}"></script>
    </body>
</html>